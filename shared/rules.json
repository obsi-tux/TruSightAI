{
  "version": 1,
  "_note": "Single rule source for Dart (offline) and Python (detect-py). UNVERIFIED PLACEHOLDER weights pending calibration on eval data (TECHNOLOGY.md section 7). No helpline numbers or URLs here; those live in shared/config.json as TODO.",
  "thresholds": { "red": 0.7, "amber": 0.4 },
  "hinglish_keywords": [
    "apna account verify",
    "turant reply karo",
    "otp share mat karo",
    "kyu share kar rahe",
    "grahak seva",
    "khata band",
    "loan approved",
    "inye paise",
    "click karo"
  ],
  "rules": [
    { "id": "urgency_en", "type": "keyword", "lang": "en", "weight": 0.2,
      "values": ["immediately", "right now", "act now", "within 24 hours", "expires today", "last warning", "urgent"] },
    { "id": "urgency_hi", "type": "keyword", "lang": "hi", "weight": 0.2,
      "values": ["तुरंत", "अभी", "फौरन", "आखरी चेतावनी", "24 घंटे"] },
    { "id": "payment_demand_en", "type": "keyword", "lang": "en", "weight": 0.3,
      "values": ["pay now", "transfer money", "send money", "gift card", "crypto wallet", "processing fee to release"] },
    { "id": "payment_demand_hi", "type": "keyword", "lang": "hi", "weight": 0.3,
      "values": ["पैसे भेजो", "पैसा ट्रांसफर", "भुगतान करें"] },
    { "id": "remote_access_app", "type": "keyword", "lang": "any", "weight": 0.35,
      "values": ["anydesk", "teamviewer", "quicksupport", "ultraviewer", "screenshare app"] },
    { "id": "secrecy_demand", "type": "keyword", "lang": "en", "weight": 0.25,
      "values": ["do not tell anyone", "keep this secret", "don't inform the bank", "confidential call"] },
    { "id": "otp_fishing", "type": "regex", "lang": "en", "weight": 0.3,
      "pattern": "(share|tell|enter|read out|input)[^.]{0,40}\\b(otp|one\\s?time\\s?password|pin)\\b" },
    { "id": "otp_fishing_hi", "type": "regex", "lang": "hi", "weight": 0.3,
      "pattern": "(ओटीपी|वन टाइम पासवर्ड)[^.]{0,30}(बता|देन|डाल|शेयर)" },
    { "id": "aadhaar_pan_demand", "type": "regex", "lang": "any", "weight": 0.25,
      "pattern": "(aadhaar|aadhar|pan card|pan number).{0,40}(verify|update|link|blocked|band)" },
    { "id": "bank_impersonation", "type": "keyword", "lang": "any", "weight": 0.2,
      "values": ["customer care from your bank", "bank security team", "grahak seva kendra", "account will be blocked", "khata block"] },
    { "id": "police_demand", "type": "keyword", "lang": "any", "weight": 0.3,
      "values": ["cyber police", "crime branch", "police ne kaha", "court notice", "legal action against you"] },
    { "id": "courier_vishing", "type": "keyword", "lang": "any", "weight": 0.25,
      "values": ["parcel stuck", "delivery agent called", "custom duty pay", "courier company complaint"] },
    { "id": "loan_upfront_fee", "type": "keyword", "lang": "any", "weight": 0.3,
      "values": ["loan approved", "sanction letter", "pay processing fee", "pre-approved loan"] },
    { "id": "prize_claim", "type": "keyword", "lang": "any", "weight": 0.25,
      "values": ["you have won", "lucky draw", "grand prize", "invoice number", "lottery"] },
    { "id": "url_shortener", "type": "regex", "lang": "any", "weight": 0.2,
      "pattern": "https?://(bit\\.ly|tinyurl\\.com|t\\.co/|goo\\.gl|shorturl\\.at|rb\\.ge|isg\\.to)/" },
    { "id": "suspicious_tld", "type": "regex", "lang": "any", "weight": 0.15,
      "pattern": "https?://[^/\"' ]+\\.(xyz|top|icu|click|link|rest|shop)(/|\"|'| |$)" },
    { "id": "ip_host_url", "type": "regex", "lang": "any", "weight": 0.3,
      "pattern": "https?://((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(:[0-9]+)?/" },
    { "id": "lookalike_domain", "type": "regex", "lang": "any", "weight": 0.25,
      "pattern": "https?://[^/]*(sbi|paytm|axis|kotak|icici| hdfc|hdfc|amazon|flipkart)[^/.]*[-_.][a-z0-9]+" },
    { "id": "whatsapp_link", "type": "regex", "lang": "any", "weight": 0.15,
      "pattern": "https?://(wa\\.me|api\\.whatsapp\\.com)/" },
    { "id": "benign_otp_protect", "type": "regex", "lang": "any", "weight": -0.3,
      "pattern": "(never share|do not share|don't share|kisi ke saath share na|किसी के साथ शेयर न)[^.]{0,30}(otp|pin|code)" }
  ]
}
